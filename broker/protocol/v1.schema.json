{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remote-mcp.local/broker/protocol/v1.schema.json",
  "title": "Remote MCP privileged broker protocol v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion", "requestId", "action", "targets", "payload", "capability",
    "transportNonce", "clientProof"
  ],
  "properties": {
    "protocolVersion": { "const": 1 },
    "requestId": { "type": "string", "format": "uuid" },
    "action": { "type": "string", "minLength": 1, "maxLength": 256 },
    "targets": {
      "type": "array",
      "maxItems": 256,
      "items": { "type": "string", "minLength": 1, "maxLength": 32768 }
    },
    "payload": {},
    "transportNonce": { "type": "string", "format": "uuid" },
    "clientProof": { "type": "string", "minLength": 1 },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "claims", "signature"],
      "properties": {
        "version": { "const": 1 },
        "claims": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version", "action", "targets", "payloadHash", "nonce", "correlationId",
            "grantId", "grantMode", "principalId", "clientId", "deviceId",
            "securityEpoch", "callerSid", "issuedAt", "expiresAt"
          ],
          "properties": {
            "version": { "const": 1 },
            "action": { "type": "string", "minLength": 1 },
            "targets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "payloadHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "nonce": { "type": "string", "format": "uuid" },
            "correlationId": { "type": "string", "minLength": 1 },
            "grantId": { "type": "string", "minLength": 1 },
            "grantMode": { "const": "full_access" },
            "principalId": { "type": "string", "minLength": 1 },
            "clientId": { "type": "string", "minLength": 1 },
            "deviceId": { "type": "string", "minLength": 1 },
            "securityEpoch": { "type": "integer", "minimum": 1 },
            "callerSid": { "type": "string", "pattern": "^S-[0-9-]+$" },
            "issuedAt": { "type": "string", "format": "date-time" },
            "expiresAt": { "type": "string", "format": "date-time" }
          }
        },
        "signature": { "type": "string", "minLength": 1 }
      }
    }
  }
}
